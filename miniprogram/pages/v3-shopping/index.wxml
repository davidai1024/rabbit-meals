<page-meta page-style="{{!pageReady || editing || chooseRole || tip ? 'overflow:hidden;' : ''}}"/>
<import src="../../templates/page-loading.wxml"/>
<template wx:if="{{!pageReady}}" is="page-loading" data="{{loading:pageLoading,error:pageLoadError}}"/>
<block wx:if="{{pageReady}}">
<view wx:if="{{cookSync.phase==='error' || cookSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>制作进度尚未同步，已保留在本机</text><text class="caption">{{cookSync.error}}</text></view><button wx:if="{{cookSync.canRetry}}" class="sync-retry" bindtap="retryCook">重试</button><button wx:if="{{cookSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveCookConflict">重新载入</button></view>
<view wx:if="{{draftSync.phase==='error' || draftSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>选择尚未同步，已保留在本机</text><text class="caption">{{draftSync.error}}</text></view><button wx:if="{{draftSync.canRetry}}" class="sync-retry" bindtap="retryDraft">重试</button><button wx:if="{{draftSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveDraftConflict">重新选择</button></view>
<view class="week-compact-head"><view class="compact-top"><view class="compact-page-title">买菜</view><button class="avatar-switch" bindtap="switchIdentity" aria-label="当前{{roleLabel}}身份，点击切换"><image src="/assets/rabbit-avatar.svg"/></button></view></view>
<view class="page shopping-simple"><view class="chips"><button class="chip {{scope==='all'?'active':''}}" data-scope="all" bindtap="scope">全部</button><button class="chip {{scope==='next'?'active':''}}" data-scope="next" bindtap="scope">下周饭</button><button class="chip {{scope==='weekend'?'active':''}}" data-scope="weekend" bindtap="scope">周末饭</button></view>
<view class="caption shopping-help">用量仅供参考 ·「家里有」表示这次够用</view>
<button class="tip-link" wx:if="{{missing.length}}" data-title="食材待补齐" data-content="这些菜的食材待补齐：{{missing}}。请到菜品库编辑后，再检查采购清单。" bindtap="tipInfo">查看待补齐食材 ›</button>
<view class="task-progress" wx:if="{{shoppingTotal}}"><view class="shopping-progress-head"><view class="shopping-progress-copy"><view class="heading">已备齐 {{shoppingDone}} / {{shoppingTotal}} 项</view><text class="caption">{{shoppingDone===shoppingTotal?'都备好了':'还差 '+(shoppingTotal-shoppingDone)+' 项'}}</text></view><button wx:if="{{role==='cook' && shoppingDone<shoppingTotal}}" class="purchase-all" bindtap="buyAll" loading="{{busy}}" disabled="{{busy}}" aria-label="将当前清单中剩余{{shoppingTotal-shoppingDone}}项食材标记为买好">一键买好</button></view><view class="quality-track"><view class="quality-fill" style="transform:scaleX({{shoppingDone/shoppingTotal}})"></view></view></view>
<view wx:for="{{items}}" wx:key="key" class="shopping-item {{item.purchaseReady?'purchase-done':''}}"><view class="shopping-item-main"><view class="grow"><view class="heading">{{item.name}} {{item.spec}}</view><view class="caption">参考 {{item.totalNeed}}{{item.unit}}</view></view><text wx:if="{{item.purchaseReady}}" class="purchase-state">✓ {{item.purchaseState==='home'?'家里有':'买好了'}}</text></view><view class="shopping-source" wx:if="{{item.sourceNames}}">做：{{item.sourceNames}}</view><button class="tip-link" wx:if="{{item.purchaseStale}}" data-title="请重新确认用量" data-content="{{item.name}}关联的菜单已变化，请检查家里或已买的是否够用，再标记家里有或买好了。" bindtap="tipInfo">用量有变化 ›</button>
<view class="purchase-actions" wx:if="{{!item.purchaseReady}}"><button class="purchase-home" data-key="{{item.key}}" data-status="home" bindtap="markPurchase" disabled="{{busy}}">家里有</button><button class="purchase-buy" data-key="{{item.key}}" data-status="bought" bindtap="markPurchase" disabled="{{busy}}">买好了</button></view><button wx:if="{{item.purchaseReady}}" class="purchase-reset" data-key="{{item.key}}" data-status="pending" bindtap="markPurchase" disabled="{{busy}}">{{item.purchaseState==='home'?'不够了，仍需买':'标错了，改为待买'}}</button></view>
<view class="empty" wx:if="{{!items.length}}"><image class="food-decor" src="/assets/decor.svg"/><view class="heading">先看看要做什么</view><view class="caption">菜单提交后，食材会自动合在这里。</view><button class="secondary" bindtap="review">查看菜单</button></view></view><view wx:if="{{chooseRole && !tip}}" class="sheet-backdrop identity-backdrop compact-identity" bindtap="cancelIdentity"><view class="meal-sheet identity" catchtap="keepPanel"><view class="row between"><view class="heading">切换身份</view><button wx:if="{{role}}" class="small" bindtap="cancelIdentity">关闭</button></view><button class="secondary" bindtap="pairSettings">两人共享设置</button><button class="role-card {{role==='guest'?'current-role':''}}" data-role="guest" bindtap="identity"><image src="/assets/solid-guest-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">点餐者</text><text class="caption">挑菜、提交菜单、写点评</text></view><text>{{role==='guest'?'当前':'切换'}}</text></button><button class="role-card {{role==='cook'?'current-role':''}}" data-role="cook" bindtap="identity"><image src="/assets/solid-cook-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">大厨</text><text class="caption">确认菜单、买菜、标记做好</text></view><text>{{role==='cook'?'当前':'切换'}}</text></button></view></view><view wx:if="{{tip}}" class="sheet-backdrop tip-backdrop" bindtap="tipDismiss"><view class="meal-sheet tip-sheet" catchtap="keepPanel"><view class="sheet-handle"></view><view class="heading">{{tip.title}}</view><view class="tip-copy">{{tip.content}}</view><button class="primary" bindtap="tipConfirm">{{tip.confirmText}}</button><button wx:if="{{tip.confirm}}" class="text-action" bindtap="tipDismiss">暂不操作</button></view></view>
</block>
