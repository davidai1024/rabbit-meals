
.swipe-tabs{display:flex;align-items:center;gap:4rpx;flex:1;min-width:0}.swipe-tab{width:auto;flex:1;background:transparent;color:#827b76;font-size:25rpx;font-weight:500;line-height:1.4;min-height:88rpx;padding:16rpx 8rpx;margin:0;border-radius:100rpx;white-space:nowrap}.swipe-tab.active{color:#bd4435;background:#fff0e9;font-weight:650}.weekend-picks{display:flex;gap:20rpx;align-items:center;padding:8rpx 0}.weekend-picks>.swipe-tabs{background:#f7f4f1;padding:4rpx;border-radius:100rpx}.weekend-picks .swipe-tab{font-size:22rpx;min-height:80rpx}.weekend-picks>.swipe-tabs:first-child{flex:.8}.swipe-cart.order-submit-cart{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8rpx 12rpx;border-radius:40rpx;padding:18rpx 24rpx;background:#ffffffdf;border:2rpx solid #fff;backdrop-filter:blur(24px);box-shadow:0 10rpx 36rpx #5a49301c}.selected-strip{grid-column:1 / -1;display:flex;gap:8rpx;align-items:center;padding-bottom:10rpx;border-bottom:1rpx solid #e9e4df;min-width:0}.selected-mini{padding:0;margin:0;width:64rpx;min-width:64rpx;height:76rpx;min-height:76rpx;border-radius:14rpx;overflow:hidden;background:#eee6df;border:2rpx solid #fff}.selected-mini image{display:block;width:100%;height:100%;object-fit:cover}.selected-hint{font-size:21rpx;color:#8e7f72;margin-left:auto;white-space:nowrap}.swipe-cart .basket-symbol{display:none}.swipe-cart .basket-link{min-height:88rpx}.swipe-cart .basket-copy .heading{font-size:26rpx}.swipe-cart .basket-copy .caption{font-size:20rpx}.swipe-cart .cart-button{padding:16rpx 28rpx}.done-dish{min-height:88rpx;width:auto;margin:16rpx 0 0;padding:16rpx 30rpx;border-radius:100rpx;background:#c94836;color:#fff;font-size:26rpx;line-height:1.5;display:inline-flex;align-items:center;justify-content:center}.done-label{display:block;color:#6c8060;font-size:24rpx;line-height:1.5;margin-top:18rpx}.work-card>.secondary{font-size:26rpx;min-height:88rpx}.menu-entry .text-action{min-height:88rpx}.illustrated-plan{position:relative;z-index:0;overflow:hidden;border:0;border-radius:40rpx;background:#f9d5a1;padding:32rpx;box-shadow:0 10rpx 26rpx #9a5b1810;color:#603e25}.illustrated-plan.plan-weekend{background:#dce8b9;color:#354b30}.illustrated-plan .plan-scene{position:absolute;top:0;right:0;width:100%;height:370rpx;object-fit:cover;z-index:0;pointer-events:none}.illustrated-plan .plan-scene-wash{position:absolute;inset:0;z-index:1;pointer-events:none}.illustrated-plan .plan-topline{align-items:flex-start;min-height:72rpx}.illustrated-plan .plan-name{font-size:38rpx;color:#583a23;line-height:1.5;max-width:65%}.illustrated-plan.plan-weekend .plan-name{color:#354b30}.illustrated-plan .plan-badge{background:#fff9e9db;color:#62452e;border:1rpx solid #ffffff99;font-size:22rpx;line-height:1.5;backdrop-filter:blur(12px)}.illustrated-plan .plan-dates{position:relative;font-size:26rpx;color:#65462d;line-height:1.6;max-width:57%;margin-top:20rpx;font-weight:600}.illustrated-plan .plan-hint{position:relative;font-size:23rpx;color:#745437;line-height:1.6;max-width:51%;margin-top:12rpx;min-height:112rpx}.illustrated-plan.plan-weekend .plan-dates,.illustrated-plan.plan-weekend .plan-hint{color:#415638}.illustrated-plan .plan-names{color:#63472f;font-size:26rpx;line-height:1.8;margin-top:28rpx;padding:20rpx 0}.illustrated-plan.plan-weekend .plan-names{color:#3c5133}.illustrated-plan .plan-footer{margin-top:8rpx}.illustrated-plan .plan-count,.illustrated-plan .plan-edit{color:#74583b}.illustrated-plan .plan-view{color:#9c3c26;font-weight:650}.illustrated-plan.plan-weekend .plan-count,.illustrated-plan.plan-weekend .plan-edit{color:#506645}.illustrated-plan.plan-weekend .plan-view{color:#345b32}.illustrated-plan .plan-pending{border-color:#926b3c30;color:#705135}.illustrated-plan .plan-pending-note{color:inherit}.illustrated-plan.plan-weekend .plan-pending{border-color:#58784030;color:#425d37}.illustrated-plan .plan-action{background:#aa4e30;color:#fff;box-shadow:none}.illustrated-plan.plan-weekend .plan-action{background:#496b3b;color:#fff}.illustrated-plan .plan-scene-wash{background:linear-gradient(90deg,#f9d5a1b8 0%,#f9d5a155 43%,transparent 64%),linear-gradient(180deg,transparent 0,transparent 240rpx,#f9d5a1 380rpx)}.illustrated-plan.plan-weekend .plan-scene-wash{background:linear-gradient(90deg,#dce8b9eb 0%,#dce8b988 40%,transparent 64%),linear-gradient(180deg,transparent 0,transparent 240rpx,#dce8b9 380rpx)}
