<page-meta page-style="{{!pageReady || editing || chooseRole || tip ? 'overflow:hidden;' : ''}}"/>
<import src="../../templates/page-loading.wxml"/>
<template wx:if="{{!pageReady}}" is="page-loading" data="{{loading:pageLoading,error:pageLoadError}}"/>
<block wx:if="{{pageReady}}">
<view wx:if="{{cookSync.phase==='error' || cookSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>制作进度尚未同步，已保留在本机</text><text class="caption">{{cookSync.error}}</text></view><button wx:if="{{cookSync.canRetry}}" class="sync-retry" bindtap="retryCook">重试</button><button wx:if="{{cookSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveCookConflict">重新载入</button></view>
<view wx:if="{{draftSync.phase==='error' || draftSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>选择尚未同步，已保留在本机</text><text class="caption">{{draftSync.error}}</text></view><button wx:if="{{draftSync.canRetry}}" class="sync-retry" bindtap="retryDraft">重试</button><button wx:if="{{draftSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveDraftConflict">重新选择</button></view>
<view class="page"><view class="page-top"><button class="identity-trigger" bindtap="switchIdentity" aria-label="当前{{roleLabel}}身份，点击切换"><image src="/assets/rabbit-avatar.svg"/><text>{{roleLabel}}</text></button></view><view class="title">记下一道拿手菜</view><block wx:if="{{r}}"><image wx:if="{{photo}}" class="recipe-photo" src="{{photo}}" mode="aspectFill"/><view wx:else class="photo-empty"><image class="photo-placeholder-icon" src="/assets/solid-plate-coral.svg"/><text>给拿手菜拍张照</text></view><button class="secondary" bindtap="photo">上传对应菜品实拍</button><button class="tip-link" wx:if="{{r.catalogVersion}}" data-title="配方参考说明" data-content="{{r.sourceLevel}} · {{r.quantityNote}}。{{r.sourceNote}}" bindtap="tipInfo">配方参考说明 ›</button><text class="label">菜名</text><input data-key="name" value="{{r.name}}" bindinput="rfield"></input><text class="label">分类</text><view class="chips"><button class="chip {{r.kind==='meat'?'active':''}}" data-key="kind" data-value="meat" bindtap="rvalue">荤菜</button><button class="chip {{r.kind==='veg'?'active':''}}" data-key="kind" data-value="veg" bindtap="rvalue">素菜</button></view><text class="label">标准制作量 · 够几顿饭</text><input type="digit" data-key="meals" value="{{r.meals}}" bindinput="rfield"></input><view class="caption" wx:if="{{legacyMeals}}">旧菜未记录饭顿数，先填3顿；请按实际调整，食材用量不会自动改变。</view><text class="label">口味 · 可多选</text><view class="chips"><button wx:for="{{tasteOptions}}" wx:key="label" class="chip {{item.selected?'active':''}}" data-value="{{item.label}}" bindtap="rtaste">{{item.label}}</button></view><view class="heading">这些饭要买什么</view><view class="caption">填写够 {{r.meals}} 顿饭的食材总用量，不是每顿用量；修改顿数不会自动缩放食材。</view><view wx:for="{{r.ingredients}}" wx:key="index" class="card"><text class="label">食材名称</text><input data-index="{{index}}" data-key="name" value="{{item.name}}" bindinput="ingredient"/><text class="label">规格（可留空）</text><input data-index="{{index}}" data-key="spec" value="{{item.spec}}" bindinput="ingredient"/><text class="label">购买数量</text><input type="digit" data-index="{{index}}" data-key="qty" value="{{item.qty}}" bindinput="ingredient"/><text class="label">采购单位</text><picker range="{{units}}" value="{{item.unit==='千克'?1:item.unit==='个'?2:item.unit==='毫升'?3:item.unit==='升'?4:0}}" data-index="{{index}}" bindchange="unit"><view class="field">{{item.unit}}</view></picker><button class="text-action" data-index="{{index}}" bindtap="remove">移除食材</button></view><button class="secondary" bindtap="add">＋ 添加食材</button><button class="secondary" bindtap="verify">{{r.purchaseVerified?'✓ 我已核实全部采购食材和用量':'我确认采购数据完整、准确'}}</button><button class="tip-link" data-title="保存与使用说明" data-content="{{r.catalogReady?'内置参考配方可直接点入；亲自核实后可作标记。':'未核实可保存，不能正式点入。'}}菜库修改不重写已提交菜单，需重新点选提交。" bindtap="tipInfo">保存与使用说明 ›</button><view class="caption catalog-source" wx:if="{{r.sourceUrl}}">配料参考：{{r.sourceTitle}}<view selectable="true">{{r.sourceUrl}}</view><view>{{r.imageCredit}}</view></view><button class="primary" bindtap="save">保存菜品</button></block></view><view wx:if="{{chooseRole && !tip}}" class="sheet-backdrop identity-backdrop compact-identity" bindtap="cancelIdentity"><view class="meal-sheet identity" catchtap="keepPanel"><view class="row between"><view class="heading">切换身份</view><button wx:if="{{role}}" class="small" bindtap="cancelIdentity">关闭</button></view><button class="secondary" bindtap="pairSettings">两人共享设置</button><button class="role-card {{role==='guest'?'current-role':''}}" data-role="guest" bindtap="identity"><image src="/assets/solid-guest-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">点餐者</text><text class="caption">挑菜、提交菜单、写点评</text></view><text>{{role==='guest'?'当前':'切换'}}</text></button><button class="role-card {{role==='cook'?'current-role':''}}" data-role="cook" bindtap="identity"><image src="/assets/solid-cook-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">大厨</text><text class="caption">确认菜单、买菜、标记做好</text></view><text>{{role==='cook'?'当前':'切换'}}</text></button></view></view><view wx:if="{{tip}}" class="sheet-backdrop tip-backdrop" bindtap="tipDismiss"><view class="meal-sheet tip-sheet" catchtap="keepPanel"><view class="sheet-handle"></view><view class="heading">{{tip.title}}</view><view class="tip-copy">{{tip.content}}</view><button class="primary" bindtap="tipConfirm">{{tip.confirmText}}</button><button wx:if="{{tip.confirm}}" class="text-action" bindtap="tipDismiss">暂不操作</button></view></view>
</block>
