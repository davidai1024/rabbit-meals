<page-meta page-style="{{!pageReady || editing || chooseRole || tip ? 'overflow:hidden;' : ''}}"/>
<import src="../../templates/page-loading.wxml"/>
<template wx:if="{{!pageReady}}" is="page-loading" data="{{loading:pageLoading,error:pageLoadError}}"/>
<block wx:if="{{pageReady}}">
<view wx:if="{{cookSync.phase==='error' || cookSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>制作进度尚未同步，已保留在本机</text><text class="caption">{{cookSync.error}}</text></view><button wx:if="{{cookSync.canRetry}}" class="sync-retry" bindtap="retryCook">重试</button><button wx:if="{{cookSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveCookConflict">重新载入</button></view>
<view wx:if="{{draftSync.phase==='error' || draftSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>选择尚未同步，已保留在本机</text><text class="caption">{{draftSync.error}}</text></view><button wx:if="{{draftSync.canRetry}}" class="sync-retry" bindtap="retryDraft">重试</button><button wx:if="{{draftSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveDraftConflict">重新选择</button></view>
<view class="page library-page"><view class="page-top"><button class="identity-trigger" bindtap="switchIdentity" aria-label="当前{{roleLabel}}身份，点击切换"><image src="/assets/rabbit-avatar.svg"/><text>{{roleLabel}}</text></button></view><view class="title">菜品库</view><view class="subtitle">拿手的菜，一道道存下来。</view><view class="row between"><view class="heading">全部菜品 · {{recipes.length}} 道</view><button class="small" wx:if="{{role==='cook'}}" bindtap="addRecipe">新增菜品</button></view><view class="caption">内置配方按1人吃3顿备料，可直接点菜；用量可按实际调整。</view><view wx:for="{{recipes}}" wx:key="id" class="divider row library-entry" data-id="{{item.id}}" bindtap="recipe" style="display:flex;width:100%;box-sizing:border-box;" hover-class="card-pressed" hover-stay-time="80"><image class="food-photo" src="{{item.image}}" mode="aspectFill"/><view class="library-copy" style="flex:1;width:0;min-width:0;overflow:hidden;"><view class="heading">{{item.name}}</view><view class="caption">{{item.category}} · {{item.purchaseVerified?'已亲自核实':item.catalogReady?'参考配方':'待补齐采购'}} · {{item.hidden?'已隐藏':item.meals+'顿'}}</view><view class="caption" wx:if="{{item.catalogVersion}}">{{item.taste}} · {{item.sourceLevel}}</view></view><view class="library-actions" style="flex:none;width:96rpx;min-width:96rpx;" wx:if="{{role==='cook'}}"><button class="small" data-id="{{item.id}}" catchtap="recipe">编辑</button><button class="text-action" data-id="{{item.id}}" catchtap="hide">{{item.hidden?'恢复':'隐藏'}}</button></view></view><view class="heading actions">想吃新菜 · 待补录</view><view wx:for="{{requests}}" wx:key="id" class="card"><view class="heading">{{item.name}}</view><view class="caption">{{item.note}}</view><view class="caption">待补录，不混进正式菜单</view><button wx:if="{{role==='cook'}}" class="secondary" data-id="{{item.id}}" bindtap="fillRequest">补录这道菜</button></view><button class="secondary" bindtap="history">历史菜单</button></view><view wx:if="{{chooseRole && !tip}}" class="sheet-backdrop identity-backdrop compact-identity" bindtap="cancelIdentity"><view class="meal-sheet identity" catchtap="keepPanel"><view class="row between"><view class="heading">切换身份</view><button wx:if="{{role}}" class="small" bindtap="cancelIdentity">关闭</button></view><button class="secondary" bindtap="pairSettings">两人共享设置</button><button class="role-card {{role==='guest'?'current-role':''}}" data-role="guest" bindtap="identity"><image src="/assets/solid-guest-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">点餐者</text><text class="caption">挑菜、提交菜单、写点评</text></view><text>{{role==='guest'?'当前':'切换'}}</text></button><button class="role-card {{role==='cook'?'current-role':''}}" data-role="cook" bindtap="identity"><image src="/assets/solid-cook-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">大厨</text><text class="caption">确认菜单、买菜、标记做好</text></view><text>{{role==='cook'?'当前':'切换'}}</text></button></view></view><view wx:if="{{tip}}" class="sheet-backdrop tip-backdrop" bindtap="tipDismiss"><view class="meal-sheet tip-sheet" catchtap="keepPanel"><view class="sheet-handle"></view><view class="heading">{{tip.title}}</view><view class="tip-copy">{{tip.content}}</view><button class="primary" bindtap="tipConfirm">{{tip.confirmText}}</button><button wx:if="{{tip.confirm}}" class="text-action" bindtap="tipDismiss">暂不操作</button></view></view>
</block>
