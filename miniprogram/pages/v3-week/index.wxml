<page-meta page-style="{{!pageReady || editing || chooseRole || tip ? 'overflow:hidden;' : ''}}"/>
<import src="../../templates/page-loading.wxml"/>
<template wx:if="{{!pageReady}}" is="page-loading" data="{{loading:pageLoading,error:pageLoadError}}"/>
<block wx:if="{{pageReady}}">
<view wx:if="{{view!=='work' && (cookSync.phase==='error' || cookSync.phase==='conflict')}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>制作进度尚未同步，已保留在本机</text><text class="caption">{{cookSync.error}}</text></view><button wx:if="{{cookSync.canRetry}}" class="sync-retry" bindtap="retryCook">重试</button><button wx:if="{{cookSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveCookConflict">重新载入</button></view>
<view wx:if="{{draftSync.phase==='error' || draftSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>选择尚未同步，已保留在本机</text><text class="caption">{{draftSync.error}}</text></view><button wx:if="{{draftSync.canRetry}}" class="sync-retry" bindtap="retryDraft">重试</button><button wx:if="{{draftSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveDraftConflict">重新选择</button></view>
<view class="week-compact-head"><view class="compact-top"><button wx:if="{{view!=='overview'}}" class="compact-back" bindtap="overview" aria-label="返回{{role==='cook'?'做饭':'已点'}}">‹</button><view class="compact-page-title">{{view==='overview'?(role==='cook'?'做饭':'已点'):view==='work'?'做饭清单':type==='next'?'下周饭':'周末饭'}}</view><button class="history-link" bindtap="history">历史</button><button class="avatar-switch" bindtap="switchIdentity" aria-label="当前{{roleLabel}}身份，点击切换"><image src="/assets/rabbit-avatar.svg"/></button></view><view wx:if="{{view==='menu'}}" class="compact-meta"><text>{{currentRange}}</text><text>{{detail.badge}}</text></view></view>
<view class="page menu-overview ordered-feed" wx:if="{{view==='overview'}}">
  <view class="ordered-feed-intro">{{role==='cook'?'接住她的小期待，把每一餐做好。':'点过的饭，都在这里等你。'}}</view>
  <view wx:if="{{currentOrders.length}}" class="ordered-section-label">这一轮的饭</view>
  <view wx:for="{{currentOrders}}" wx:key="key" class="plan-preview ordered-card plan-{{item.type}}" data-type="{{item.type}}" data-key="{{item.key}}" bindtap="openPlan" hover-class="card-pressed" hover-stay-time="80">
  <view class="ordered-card-hero"><image class="ordered-card-art" src="{{item.type==='next'?'/assets/menu-prep.svg':'/assets/menu-weekend.svg'}}" mode="aspectFill" aria-hidden="true"/><text class="ordered-card-badge tone-{{item.tone}}">{{item.badge}}</text></view>
  <view class="ordered-card-copy"><view class="ordered-card-title">{{item.title}}</view><view class="ordered-card-subtitle">{{item.subtitle}}</view>
    <view class="ordered-card-meta"><text>{{item.dateRange}}</text><text>{{item.count}} 道菜</text></view>
    <view class="ordered-card-photos"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="id" src="{{photo.image || '/assets/rabbit-avatar.svg'}}" mode="aspectFill" aria-label="{{photo.name}}"/></view>
    <view wx:if="{{item.draftHint}}" class="ordered-draft-note">{{item.draftHint}}</view>
    <view class="ordered-card-actions">
      <button wx:if="{{item.canModify}}" class="ordered-card-modify" data-type="{{item.type}}" data-key="{{item.key}}" catchtap="modify" disabled="{{modifyingMenu || busy}}" loading="{{modifyingMenu}}" aria-label="修改{{item.title}}">修改</button>
      <button wx:if="{{item.canConfirm}}" class="ordered-card-confirm" data-type="{{item.type}}" data-key="{{item.key}}" catchtap="confirm" disabled="{{busy}}" loading="{{busy}}">{{busy?'确认中…':'确认菜单'}}</button>
      <button class="ordered-card-view" data-type="{{item.type}}" data-key="{{item.key}}" catchtap="openPlan">查看菜单 ›</button>
    </view>
    <view wx:if="{{item.isCurrent && item.locked}}" class="ordered-lock-note">已有菜做好，这份菜单不能再换菜啦。</view>
  </view>
</view>
  <view wx:if="{{pastOrders.length}}" class="ordered-section-label past-section-label">以前的饭</view>
  <view wx:for="{{pastOrders}}" wx:key="key" class="plan-preview ordered-card ordered-past plan-{{item.type}}" data-type="{{item.type}}" data-key="{{item.key}}" bindtap="openPlan" hover-class="card-pressed" hover-stay-time="80">
  <view class="ordered-card-hero"><image class="ordered-card-art" src="{{item.type==='next'?'/assets/menu-prep.svg':'/assets/menu-weekend.svg'}}" mode="aspectFill" aria-hidden="true"/><text class="ordered-card-badge tone-{{item.tone}}">{{item.badge}}</text></view>
  <view class="ordered-card-copy"><view class="ordered-card-title">{{item.title}}</view><view class="ordered-card-subtitle">{{item.subtitle}}</view>
    <view class="ordered-card-meta"><text>{{item.dateRange}}</text><text>{{item.count}} 道菜</text></view>
    <view class="ordered-card-photos"><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="id" src="{{photo.image || '/assets/rabbit-avatar.svg'}}" mode="aspectFill" aria-label="{{photo.name}}"/></view>
    <view wx:if="{{item.draftHint}}" class="ordered-draft-note">{{item.draftHint}}</view>
    <view class="ordered-card-actions">
      <button wx:if="{{item.canModify}}" class="ordered-card-modify" data-type="{{item.type}}" data-key="{{item.key}}" catchtap="modify" disabled="{{modifyingMenu || busy}}" loading="{{modifyingMenu}}" aria-label="修改{{item.title}}">修改</button>
      <button wx:if="{{item.canConfirm}}" class="ordered-card-confirm" data-type="{{item.type}}" data-key="{{item.key}}" catchtap="confirm" disabled="{{busy}}" loading="{{busy}}">{{busy?'确认中…':'确认菜单'}}</button>
      <button class="ordered-card-view" data-type="{{item.type}}" data-key="{{item.key}}" catchtap="openPlan">查看菜单 ›</button>
    </view>
    <view wx:if="{{item.isCurrent && item.locked}}" class="ordered-lock-note">已有菜做好，这份菜单不能再换菜啦。</view>
  </view>
</view>
  <view wx:if="{{!hasOrdered}}" class="ordered-empty"><image src="/assets/menu-prep.svg" mode="aspectFill" aria-hidden="true"/><view class="heading">{{role==='cook'?'饭桌还在等一份小期待':'还没交给大厨的菜单'}}</view><view class="caption">{{role==='cook'?'她点好并提交后，菜单就会出现在这里。':'去点几道喜欢的菜，一起把饭安排上。'}}</view><button wx:if="{{role==='guest'}}" class="primary" bindtap="menu">去点菜</button></view>
  <button wx:if="{{role==='cook' && currentOrders.length}}" class="secondary ordered-work-link" bindtap="workspace">打开做饭清单</button>
</view><view class="page v3-menu-page" wx:if="{{view==='menu'}}"><button class="tip-link" wx:if="{{plan.suggestion}}" data-title="大厨的调整提议" data-content="{{plan.suggestion}}" bindtap="tipInfo">查看大厨提议 ›</button><view wx:if="{{meat.length}}" class="menu-section">荤菜 <text class="muted">{{counts.meat}}{{type==='next'?'/3':''}}</text></view><view wx:for="{{meat}}" wx:key="id" class="menu-entry"><image src="{{item.image}}" class="menu-photo" mode="aspectFill"/><view class="grow"><view class="menu-dish">{{item.name}}</view><view class="caption">{{item.spice}}</view><view class="caption" wx:if="{{type==='weekend'}}">{{item.day}} {{item.meal}}</view><view class="caption" wx:if="{{item.note}}">心愿：{{item.note}} · 采购调整待核实</view></view><button wx:if="{{role==='cook' && !item.tasks.cook && (submittedPlan.status==='confirmed' || submittedPlan.status==='cooked' || submittedPlan.status==='eaten')}}" class="done-dish" data-id="{{item.id}}" data-type="{{type}}" disabled="{{busy}}" bindtap="finishDish">做好了</button><text wx:if="{{role==='cook' && item.tasks.cook}}" class="done-label">✓ 已做好</text><button class="dish-review {{item.hasFeedback?'reviewed':''}}" wx:if="{{role==='guest' && item.tasks.cook}}" data-id="{{item.id}}" bindtap="record">{{item.hasFeedback?'已点评':'点评'}}</button></view><view wx:if="{{veg.length}}" class="menu-section">素菜 <text class="muted">{{counts.veg}}{{type==='next'?'/3':''}}</text></view><view wx:for="{{veg}}" wx:key="id" class="menu-entry"><image src="{{item.image}}" class="menu-photo" mode="aspectFill"/><view class="grow"><view class="menu-dish">{{item.name}}</view><view class="caption">{{item.spice}}</view><view class="caption" wx:if="{{type==='weekend'}}">{{item.day}} {{item.meal}}</view><view class="caption" wx:if="{{item.note}}">心愿：{{item.note}} · 采购调整待核实</view></view><button wx:if="{{role==='cook' && !item.tasks.cook && (submittedPlan.status==='confirmed' || submittedPlan.status==='cooked' || submittedPlan.status==='eaten')}}" class="done-dish" data-id="{{item.id}}" data-type="{{type}}" disabled="{{busy}}" bindtap="finishDish">做好了</button><text wx:if="{{role==='cook' && item.tasks.cook}}" class="done-label">✓ 已做好</text><button class="dish-review {{item.hasFeedback?'reviewed':''}}" wx:if="{{role==='guest' && item.tasks.cook}}" data-id="{{item.id}}" bindtap="record">{{item.hasFeedback?'已点评':'点评'}}</button></view><view class="empty menu-empty" wx:if="{{!lines.length}}"><image src="/assets/solid-plate-gray.svg" class="empty-plate"/><view class="heading">{{role==='cook'?'等待她的点餐':'这一餐，想吃点什么？'}}</view><view class="caption">{{role==='cook'?'点餐提交后，在这里确认菜单和安排制作。':'先选喜欢的菜，再一起把菜单定下来。'}}</view></view><view class="detail-actions" wx:if="{{role==='guest'}}"><button class="detail-edit" wx:if="{{detail.showModify}}" bindtap="modify" disabled="{{modifyingMenu || busy}}" loading="{{modifyingMenu}}">修改菜单</button><button class="tip-link" wx:if="{{detail.locked}}" data-title="菜单已锁定" data-content="已有菜做好，这份菜单不能再修改。制作进度和点评仍可正常记录。" bindtap="tipInfo">为什么不能修改？</button></view><view class="detail-actions" wx:if="{{role==='cook'&&lines.length}}"><button wx:if="{{detail.showConfirm}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="confirm">{{busy?'确认中…':'确认菜单'}}</button><view class="detail-action-row"><button class="secondary" bindtap="workspace">做饭清单</button><button wx:if="{{!detail.locked && submittedPlan.status!=='draft'}}" class="detail-edit" bindtap="suggest">提议调整</button></view></view></view><view class="page" wx:if="{{view==='work'}}"><view class="task-progress"><view class="row between"><view class="heading">已制作 {{workDone}} / {{workTotal}} 道</view><text class="caption">{{workTotal && workDone===workTotal?'都做好啦':'按实际进度勾选'}}</text></view><view class="quality-track"><view class="quality-fill" style="transform:scaleX({{workTotal?workDone/workTotal:0}})"></view></view><view class="cook-sync" aria-live="polite"><block wx:if="{{cookSync.slow || cookSync.phase==='error' || cookSync.phase==='conflict'}}"><text>{{cookSync.phase==='conflict'?'菜单有更新，制作标记已保留':cookSync.phase==='error'?'制作进度尚未同步，已保留':'制作进度同步中…'}}</text><button wx:if="{{cookSync.canRetry}}" class="sync-retry" bindtap="retryCook">重试</button><button wx:if="{{cookSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveCookConflict">重新载入</button></block></view></view><view class="empty" wx:if="{{!workTotal}}"><image class="food-decor" src="/assets/decor.svg"/><view class="heading">先把菜单定下来</view><view class="caption">提交并确认菜单后，就能逐道安排制作。</view><button class="secondary" bindtap="overview">查看菜单</button></view><view class="card"><view class="heading">下周冷冻 · {{nextLines.length}} 道</view><text wx:for="{{nextLines}}" wx:key="id" class="caption">{{item.name}}　</text></view><view class="card"><view class="heading">周末现吃 · {{weekendLines.length}} 道</view><text wx:for="{{weekendLines}}" wx:key="id" class="caption">{{item.day}} {{item.meal}} {{item.name}}　</text></view><view wx:for="{{work}}" wx:key="workKey" class="card work-card {{item.tasks.cook?'work-done':''}}"><view class="row"><image class="food-photo" src="{{item.image}}" mode="aspectFill"/><view class="grow"><view class="heading">{{item.name}}</view><view class="caption">{{item.type==='next'?'下周备餐':item.day+' '+item.meal}} · {{item.portions?item.portions+'份':item.multiplier+'倍'}}</view></view><button wx:if="{{role==='cook' && !item.tasks.cook}}" class="done-dish" data-type="{{item.type}}" data-id="{{item.id}}" disabled="{{busy || !item.ready}}" bindtap="finishDish">做好了</button><text wx:if="{{role==='cook' && item.tasks.cook}}" class="done-label">✓ 已做好</text></view><view class="caption" wx:if="{{!item.ready}}">{{item.statusLabel}} · 确认后才能制作<button wx:if="{{item.statusLabel==='已提交 · 待大厨确认'}}" class="small" data-type="{{item.type}}" bindtap="confirm">确认这份菜单</button></view><button wx:if="{{role==='guest' && item.tasks.cook}}" class="secondary" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="record">{{item.hasFeedback?'修改反馈':'吃得怎么样'}}</button></view><button class="secondary" bindtap="workspace">返回菜单</button></view><view wx:if="{{editing && !tip}}" class="sheet-backdrop" bindtap="dismissReview"><view class="meal-sheet {{editing.form==='record'?'review-sheet':''}}" catchtap="keepPanel"><view wx:if="{{editing.form==='record'}}" class="sheet-handle"></view><view wx:if="{{editing.form!=='record'}}" class="row between"><view class="sheet-handle"></view><button class="small" bindtap="cancel">关闭</button></view><view wx:if="{{editing.form==='suggest'}}"><view class="heading">提议替换／调整</view><text class="label">提议</text><textarea data-key="note" value="{{editing.note}}" bindinput="field"></textarea><button class="primary" bindtap="suggestSave">记到菜单上</button></view><view wx:if="{{role==='guest' && editing.form==='record'}}"><view class="heading">这顿饭，吃得怎么样？</view><view class="chips"><button class="chip {{editing.result==='吃完了'?'active':''}}" data-key="result" data-value="吃完了" bindtap="value">吃完了</button><button class="chip {{editing.result==='有剩余'?'active':''}}" data-key="result" data-value="有剩余" bindtap="value">有剩余</button><button class="chip {{editing.result==='不够吃'?'active':''}}" data-key="result" data-value="不够吃" bindtap="value">不够吃</button></view><button class="review-love {{editing.again?'is-loved':''}} {{loveBurst?'love-burst':''}}" bindtap="again" aria-pressed="{{editing.again}}" aria-label="下次还想吃"><view class="love-art"><image class="love-rabbit" src="/assets/review-supper.svg" mode="aspectFit"/><view class="love-sparks" aria-hidden="true"><text class="spark spark-a">♥</text><text class="spark spark-b">♥</text><text class="spark spark-c">♥</text><text class="spark spark-d">♥</text></view></view><view class="review-love-copy"><text class="love-eyebrow">{{editing.again?'这道菜，被偏爱了':'给这一餐一点偏爱'}}</text><text class="review-love-title">下次还想吃</text><text class="review-love-note">{{editing.again?'好吃的，想和你再吃一次':'点一下，把喜欢告诉大厨'}}</text></view><text class="love-mark">{{editing.again?'✓':'＋'}}</text></button><text class="label">想对大厨说</text><textarea data-key="note" value="{{editing.note}}" bindinput="field"></textarea><button class="primary" bindtap="recordSave" disabled="{{busy}}">提交点评</button></view></view></view><view wx:if="{{chooseRole && !tip}}" class="sheet-backdrop identity-backdrop compact-identity" bindtap="cancelIdentity"><view class="meal-sheet identity" catchtap="keepPanel"><view class="row between"><view class="heading">切换身份</view><button wx:if="{{role}}" class="small" bindtap="cancelIdentity">关闭</button></view><button class="secondary" bindtap="pairSettings">两人共享设置</button><button class="role-card {{role==='guest'?'current-role':''}}" data-role="guest" bindtap="identity"><image src="/assets/solid-guest-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">点餐者</text><text class="caption">挑菜、提交菜单、写点评</text></view><text>{{role==='guest'?'当前':'切换'}}</text></button><button class="role-card {{role==='cook'?'current-role':''}}" data-role="cook" bindtap="identity"><image src="/assets/solid-cook-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">大厨</text><text class="caption">确认菜单、买菜、标记做好</text></view><text>{{role==='cook'?'当前':'切换'}}</text></button></view></view><view wx:if="{{tip}}" class="sheet-backdrop tip-backdrop" bindtap="tipDismiss"><view class="meal-sheet tip-sheet" catchtap="keepPanel"><view class="sheet-handle"></view><view class="heading">{{tip.title}}</view><view class="tip-copy">{{tip.content}}</view><button class="primary" bindtap="tipConfirm">{{tip.confirmText}}</button><button wx:if="{{tip.confirm}}" class="text-action" bindtap="tipDismiss">{{tip.cancelText||'暂不操作'}}</button></view></view>
</block>
