.pair{padding:40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));background:#fff;min-height:100vh;box-sizing:border-box}.title{font-size:42rpx;font-weight:600}.copy{font-size:26rpx;color:#80746c;line-height:1.7;margin:28rpx 0}.roles{display:flex;gap:16rpx;margin:32rpx 0}.roles button{flex:1;width:0;margin:0}.active{background:#fff0e8;color:#c83f2b}button{margin:20rpx 0;padding:24rpx;min-height:88rpx;border-radius:24rpx;font-size:28rpx}.primary{background:#c83f2b;color:#fff}input{border:1rpx solid #e4ddd8;padding:24rpx;min-height:88rpx;box-sizing:border-box;border-radius:20rpx}.code{font-size:28rpx;word-break:break-all;padding:24rpx;background:#fff4ed}.error{color:#b53425;padding:24rpx;background:#fff0ed}

.test-tools{margin-top:48rpx;padding:28rpx;border:1rpx solid #eaded3;border-radius:28rpx;background:#faf7f2}.test-title{font-size:30rpx;font-weight:600;color:#514339}.test-copy{font-size:24rpx;line-height:1.7;color:#80746c;margin-top:14rpx}.reset-button{width:100%;background:#fff;color:#b4372a;border:1rpx solid #dfb4aa;margin-top:24rpx}.restore-button{width:100%;background:#fff;color:#66594e;border:1rpx solid #ded5cc;margin-bottom:0}.restore-copy{margin-top:16rpx}.reset-notice{margin-top:20rpx;padding:18rpx;border-radius:16rpx;background:#eef3e9;color:#526345;font-size:26rpx;line-height:1.6}
.notification-tools{margin-top:40rpx;padding:28rpx;border:1rpx solid #eed8c4;border-radius:28rpx;background:#fff8ef}.notification-row{padding:20rpx 0;border-bottom:1rpx solid #eee2d7}.notification-label{font-size:28rpx;font-weight:600;color:#514339}.notification-status{margin-top:10rpx;font-size:26rpx;color:#806b55}.notification-detail{margin-top:8rpx;font-size:24rpx;line-height:1.6;color:#8b7c6e}.notification-button{width:100%;box-sizing:border-box;margin-top:28rpx}.notification-close{width:100%;box-sizing:border-box;background:#fff;color:#806b55;border:1rpx solid #e6d8ca}.notification-error{margin-top:20rpx;padding:18rpx;border-radius:16rpx;background:#fff0ed;color:#a8392a;font-size:26rpx;line-height:1.6}
