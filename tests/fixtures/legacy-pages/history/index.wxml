<view class="page"><view class="eyebrow">LITTLE MEALS, GOOD MEMORIES</view><view class="title">过去的小饭桌</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!plans.length}}" class="card empty">还没有提交过菜单。<view class="muted">第一顿想吃的饭，从点菜开始。</view></view><view class="card" wx:for="{{plans}}" wx:key="week"><view class="heading">{{item.week}}</view><view>{{item.names}}</view><view class="muted">{{item.extra}}</view><button class="secondary" data-week="{{item.week}}" bindtap="open">查看当时的采购估算</button></view><view wx:if="{{selected}}" class="card"><view class="heading">{{selected.week}} · 提交时快照</view><view class="money">¥ {{shopping.total}}</view><view class="muted">已知小计 · {{shopping.missingPrices}} 项缺价。保留当时的配方、食量和价格。</view><view wx:for="{{shopping.items}}" wx:key="key" class="divider">{{item.name}} · 买 {{item.buy}} {{item.unit}}<view class="muted">{{item.cost===null?'当时缺价格':'当时预计 ¥ '+item.cost}}</view></view><button class="secondary" bindtap="close">收起</button></view></view>