<page-meta page-style="{{!pageReady || editing || chooseRole || tip ? 'overflow:hidden;' : ''}}"/>
<import src="../../templates/page-loading.wxml"/>
<template wx:if="{{!pageReady}}" is="page-loading" data="{{loading:pageLoading,error:pageLoadError}}"/>
<block wx:if="{{pageReady}}">
<view wx:if="{{cookSync.phase==='error' || cookSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>制作进度尚未同步，已保留在本机</text><text class="caption">{{cookSync.error}}</text></view><button wx:if="{{cookSync.canRetry}}" class="sync-retry" bindtap="retryCook">重试</button><button wx:if="{{cookSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveCookConflict">重新载入</button></view>
<view wx:if="{{draftSync.phase==='error' || draftSync.phase==='conflict'}}" class="draft-sync-banner" aria-live="polite"><view class="draft-sync-copy"><text>选择尚未同步，已保留在本机</text><text class="caption">{{draftSync.error}}</text></view><button wx:if="{{draftSync.canRetry}}" class="sync-retry" bindtap="retryDraft">重试</button><button wx:if="{{draftSync.phase==='conflict'}}" class="sync-retry" bindtap="resolveDraftConflict">重新选择</button></view>
<view class="page history-page {{orderedView?'ordered-menu-page':''}}"><view class="detail-topbar"><button class="text-action" bindtap="backFromHistory">{{orderedView?(originOrders?(role==='cook'?'‹ 返回做饭':'‹ 返回已点'):'‹ 返回点菜'):'‹ 返回已点'}}</button><button class="identity-link" bindtap="switchIdentity">{{roleLabel}}身份</button></view><view class="title">{{orderedView?'已点菜单':'历史菜单'}}</view><view class="caption">{{orderedView?'这份菜单已经交给大厨，安心等饭香。':'按用餐周期排列 · 可以回看、补记反馈和复用'}}</view>
<view class="empty" wx:if="{{orderedView && !selected && !busy}}"><view class="heading">这份菜单暂时找不到啦</view><view class="caption">可能已清空，回到点菜看看现在的安排。</view></view><block wx:if="{{!selected && !orderedView}}"><view class="chips"><button class="chip {{historyType==='all'?'active':''}}" data-type="all" bindtap="historyType">全部</button><button class="chip {{historyType==='next'?'active':''}}" data-type="next" bindtap="historyType">下周菜单</button><button class="chip {{historyType==='weekend'?'active':''}}" data-type="weekend" bindtap="historyType">周末菜单</button></view>
<view wx:for="{{history}}" wx:key="key" class="card history-card" data-key="{{item.key}}" bindtap="detail" hover-class="card-pressed" hover-stay-time="80"><view class="heading">{{item.periodTitle}}</view><view class="caption">{{item.typeTitle}} · {{item.statusLabel}}</view><view class="history-photos"><image wx:for="{{item.photos}}" wx:for-item="dish" wx:key="id" class="history-photo" src="{{dish.image}}" mode="aspectFill" aria-label="{{dish.name}}"/></view><view class="history-names">{{item.names}}</view><view class="row between"><text class="caption">{{item.lines.length}} 道菜</text><button class="text-action" data-key="{{item.key}}" catchtap="detail">查看详情 ›</button></view></view>
<view class="empty" wx:if="{{!history.length}}"><image class="food-decor" src="/assets/decor.svg"/><view class="heading">每一餐，慢慢攒下来</view><view class="caption">提交过的菜单会保留在这里。</view></view>
<block wx:if="{{legacy.length}}"><view class="heading">旧版菜单 · 仅保留历史</view><view wx:for="{{legacy}}" wx:key="week" class="divider"><view>{{item.week}}</view><view class="caption">{{item.names}}</view></view><view class="caption">旧九餐记录不会占用新一期3+3名额。</view></block></block>
<block wx:if="{{selected}}"><button wx:if="{{!orderedView}}" class="text-action" bindtap="closeDetail">‹ 返回历史列表</button><view class="menu-kicker">{{selected.periodTitle}}</view><view class="heading">{{selected.typeTitle}}</view><view class="caption">{{selected.statusLabel}} · 原菜单与采购记录保留</view>
<view class="caption" wx:if="{{role==='cook' && selected.status==='submitted'}}">这份菜单尚未确认，核对后可继续补记制作。<button class="secondary" bindtap="confirmHistory" disabled="{{busy}}">确认这份历史菜单</button></view><view wx:for="{{selected.lines}}" wx:key="id" class="history-line"><view class="row"><image class="history-thumb" src="{{item.image}}" mode="aspectFill" aria-label="{{item.name}}"/><view class="grow"><view class="heading">{{item.name}}</view><view class="caption">{{item.portions?item.portions+'份':item.multiplier+'倍'}} · {{item.spice}} · {{item.tasks.cook?'已制作':'尚未制作'}}</view><view class="caption" wx:if="{{selected.type==='weekend'}}">{{item.day}} {{item.meal}}</view></view><button wx:if="{{role==='guest' && item.tasks.cook}}" class="dish-review {{item.myFeedback?'reviewed':''}}" data-id="{{item.id}}" bindtap="record">{{item.myFeedback?'已点评':'点评'}}</button></view><view class="caption" wx:if="{{item.note}}">备注：{{item.note}}</view><view class="caption" wx:if="{{item.storage}}">{{item.storage}} · {{item.eatDate}} · {{item.reheat}}</view><view wx:for="{{item.feedback}}" wx:for-item="record" wx:key="id" class="feedback-note">{{record.roleLabel}}：{{record.result}}{{record.again?' · 下次还想吃':''}}<view wx:if="{{record.note}}">{{record.note}}</view></view><button wx:if="{{item.canCook}}" class="secondary" data-id="{{item.id}}" bindtap="cooked" disabled="{{busy}}">补记已制作</button></view>
<view class="detail-actions" wx:if="{{role==='guest' && !orderedView}}"><view class="caption">按现在的菜品配方生成本期草稿，检查后再提交。</view><button class="primary" bindtap="reuse" disabled="{{busy}}">复用到本期草稿</button></view></block></view>
<view wx:if="{{role==='guest' && editing && !tip}}" class="sheet-backdrop" bindtap="dismissReview"><view class="meal-sheet review-sheet" catchtap="keepPanel"><view class="sheet-handle"></view><view class="heading">这顿饭，吃得怎么样？</view><view class="chips"><button class="chip {{editing.result==='吃完了'?'active':''}}" data-key="result" data-value="吃完了" bindtap="value">吃完了</button><button class="chip {{editing.result==='有剩余'?'active':''}}" data-key="result" data-value="有剩余" bindtap="value">有剩余</button><button class="chip {{editing.result==='不够吃'?'active':''}}" data-key="result" data-value="不够吃" bindtap="value">不够吃</button></view><button class="review-love {{editing.again?'is-loved':''}} {{loveBurst?'love-burst':''}}" bindtap="again" aria-pressed="{{editing.again}}" aria-label="下次还想吃"><view class="love-art"><image class="love-rabbit" src="/assets/review-supper.svg" mode="aspectFit"/><view class="love-sparks" aria-hidden="true"><text class="spark spark-a">♥</text><text class="spark spark-b">♥</text><text class="spark spark-c">♥</text><text class="spark spark-d">♥</text></view></view><view class="review-love-copy"><text class="love-eyebrow">{{editing.again?'这道菜，被偏爱了':'给这一餐一点偏爱'}}</text><text class="review-love-title">下次还想吃</text><text class="review-love-note">{{editing.again?'好吃的，想和你再吃一次':'点一下，把喜欢告诉大厨'}}</text></view><text class="love-mark">{{editing.again?'✓':'＋'}}</text></button><text class="label">想对大厨说</text><textarea data-key="note" value="{{editing.note}}" bindinput="field"></textarea><button class="primary" bindtap="recordSave" disabled="{{busy}}">提交点评</button></view></view><view wx:if="{{chooseRole && !tip}}" class="sheet-backdrop identity-backdrop compact-identity" bindtap="cancelIdentity"><view class="meal-sheet identity" catchtap="keepPanel"><view class="row between"><view class="heading">切换身份</view><button wx:if="{{role}}" class="small" bindtap="cancelIdentity">关闭</button></view><button class="secondary" bindtap="pairSettings">两人共享设置</button><button class="role-card {{role==='guest'?'current-role':''}}" data-role="guest" bindtap="identity"><image src="/assets/solid-guest-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">点餐者</text><text class="caption">挑菜、提交菜单、写点评</text></view><text>{{role==='guest'?'当前':'切换'}}</text></button><button class="role-card {{role==='cook'?'current-role':''}}" data-role="cook" bindtap="identity"><image src="/assets/solid-cook-coral.svg" class="role-icon"/><view class="role-copy"><text class="heading">大厨</text><text class="caption">确认菜单、买菜、标记做好</text></view><text>{{role==='cook'?'当前':'切换'}}</text></button></view></view><view wx:if="{{tip}}" class="sheet-backdrop tip-backdrop" bindtap="tipDismiss"><view class="meal-sheet tip-sheet" catchtap="keepPanel"><view class="sheet-handle"></view><view class="heading">{{tip.title}}</view><view class="tip-copy">{{tip.content}}</view><button class="primary" bindtap="tipConfirm">{{tip.confirmText}}</button><button wx:if="{{tip.confirm}}" class="text-action" bindtap="tipDismiss">暂不操作</button></view></view>
</block>
