.dock{position:fixed;bottom:8px;left:24rpx;right:24rpx;display:flex;padding:8rpx;border-radius:100rpx;background:#fffffffa;border:2rpx solid #fff;box-shadow:0 8rpx 24rpx #00000012,inset 0 2rpx 2rpx #fff;z-index:30;box-sizing:border-box}
.tab-track{position:absolute;left:8rpx;right:8rpx;top:8rpx;bottom:8rpx;pointer-events:none}.tab-indicator{height:100%;border-radius:100rpx;background:linear-gradient(155deg,#f4f4f4,#eaeaea);box-shadow:inset 0 2rpx 2rpx #fff,0 2rpx 8rpx #0000000b;transition:none}
.tab{position:relative;z-index:1;display:flex;flex:1;min-width:0;min-height:100rpx;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;background:transparent;border:0;padding:8rpx;margin:0;border-radius:100rpx;font-size:24rpx;line-height:1.4;color:#383838}.tab::after{border:0}.tab.selected{font-weight:600}.tab-icons{position:relative;width:44rpx;height:44rpx}.tab-icon{position:absolute;inset:0;width:44rpx;height:44rpx;transition:none}.coral{opacity:0}.coral.active{opacity:1}.gray.inactive{opacity:0}.tab-pressed{opacity:.7}
