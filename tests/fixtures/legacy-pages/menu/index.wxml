<view class="takeaway"><view class="order-header"><view class="order-title">兔子吃饭了</view><view class="muted">下周在家吃 9 餐，留 1 餐出去吃</view><view class="coverage-row"><view>荤菜 <text class="blue">{{coverage.meatMeals}} / 9 餐</text><view class="caption">已选 {{coverage.meatKinds}} / 3 种</view></view><view>素菜 <text class="blue">{{coverage.vegMeals}} / 9 餐</text><view class="caption">已选 {{coverage.vegKinds}} / 3 种</view></view></view><input class="search" value="{{query}}" bindinput="search" placeholder="搜索想吃的菜" aria-label="搜索菜名" /><view class="segmented"><button wx:for="{{tabs}}" wx:key="*this" class="segment {{tab===item?'selected':''}}" data-value="{{item}}" bindtap="tab">{{item}}</button></view></view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="setup">家庭设置</button></view><view class="order-layout" wx:if="{{loaded}}"><view class="category-rail"><button wx:for="{{categories}}" wx:key="*this" class="rail-item {{category===item?'selected':''}}" data-value="{{item}}" bindtap="category">{{item}}</button><view class="rail-tip">一荤一素<view>每菜约3餐</view></view></view><view class="food-list"><view class="list-heading">{{tab==='菜单'?category:tab}}</view><view class="food-card" wx:for="{{filtered}}" wx:key="id"><image wx:if="{{item.image}}" class="food-photo" src="{{item.image}}" mode="aspectFill" aria-label="{{item.name}}" /><view wx:else class="food-photo pending">菜图待导入</view><view class="food-info"><view class="food-name">{{item.name}}</view><view class="caption">{{item.taste||'口味可选'}} · {{item.imageSource==='user'?'自家照片':'AI 示例'}}</view><view wx:if="{{item.count}}" class="choice-summary">{{item.spice}} · {{item.servings}} 份 × {{item.count}} 餐</view><view class="food-actions"><button class="favorite-button" data-id="{{item.id}}" bindtap="favorite" disabled="{{busy}}" aria-label="{{item.favorite?'取消收藏':'收藏'}}{{item.name}}">{{item.favorite?'已收藏':'收藏'}}</button><button wx:if="{{item.count}}" class="remove-button" data-id="{{item.id}}" bindtap="remove" aria-label="移除{{item.name}}">−</button><button class="add-button" data-id="{{item.id}}" bindtap="open" aria-label="{{item.count?'修改':'添加'}}{{item.name}}">{{item.count?'修改':'添加'}}</button></view></view></view><view class="empty" wx:if="{{!filtered.length}}">{{tab==='收藏'?'还没有收藏，点菜卡上的收藏即可加入':tab==='常点'?'提交过的菜会出现在这里':'没有找到这道菜'}}</view></view></view><view class="order-cart"><view class="grow"><view class="food-name">已选 {{total}} 道菜</view><view class="caption">每餐一荤一素 · 家庭份量</view></view><button class="cart-button" bindtap="review">查看菜单</button></view><view class="sheet-backdrop" wx:if="{{editing}}"><view class="meal-sheet"><view class="sheet-handle"></view><view class="row between"><view class="heading">{{editing.name}}</view><button class="small" bindtap="cancel">取消</button></view><view class="label">口味</view><view class="segmented"><button class="segment {{editing.spice==='不辣'?'selected':''}}" data-value="不辣" bindtap="spice">不辣</button><button class="segment {{editing.spice==='辣'?'selected':''}}" data-value="辣" bindtap="spice">辣</button></view><view class="setting-line"><view class="grow"><view>每餐几份</view><view class="caption">1份 = 按你们饭量的一餐家庭用量</view></view><button class="small" data-key="servings" data-delta="-1" bindtap="adjust" aria-label="减少份数">−</button><text>{{editing.servings}}</text><button class="small" data-key="servings" data-delta="1" bindtap="adjust" aria-label="增加份数">＋</button></view><view class="setting-line"><view class="grow"><view>覆盖几餐</view><view class="caption">建议每道菜覆盖 2～3 餐</view></view><button class="small" data-key="count" data-delta="-1" bindtap="adjust" aria-label="减少餐数">−</button><text>{{editing.count}}</text><button class="small" data-key="count" data-delta="1" bindtap="adjust" aria-label="增加餐数">＋</button></view><button class="primary" bindtap="save">确定 · {{editing.servings}} 份 × {{editing.count}} 餐</button></view></view></view>