.page-loading-shell{position:fixed;inset:0;z-index:180;display:flex;align-items:center;justify-content:center;width:100%;height:100%;padding:32px 24px;box-sizing:border-box;background:#fffdf9;color:#735a47;overflow:hidden}
.page-loading-content{width:100%;max-width:320px;text-align:center}
.page-loading-avatar{display:flex;align-items:center;justify-content:center;width:92px;height:92px;margin:0 auto 22px;border:1px solid #f5e9dd;border-radius:50%;background:#fff8ef;box-sizing:border-box}
.page-loading-avatar image{display:block;width:72px;height:72px;pointer-events:none}
.page-loading-title{font-size:18px;font-weight:500;line-height:1.6;letter-spacing:.03em}
.page-loading-dots{display:flex;align-items:center;justify-content:center;gap:7px;height:24px;margin-top:14px}
.page-loading-dots>view{width:5px;height:5px;border-radius:50%;background:#d99376;opacity:.5;animation:table-dot 1.5s ease-in-out infinite}
.page-loading-dots>view:nth-child(2){animation-delay:.18s}
.page-loading-dots>view:nth-child(3){animation-delay:.36s}
.page-loading-error{margin:12px auto 24px;font-size:14px;line-height:1.7;color:#998372;word-break:break-word;overflow-wrap:anywhere}
.page-loading-shell .page-loading-retry{display:flex;align-items:center;justify-content:center;width:100%;max-width:240px;min-width:44px;min-height:44px;margin:0 auto;padding:12px 24px;border:0;border-radius:22px;background:#c93e2f;color:#fff;font-size:15px;font-weight:500;line-height:1.5;box-shadow:none;box-sizing:border-box}
.page-loading-shell .page-loading-retry::after{border:0}
.page-loading-shell .page-loading-retry[disabled]{background:#dfb5a2;color:#fff}
.page-loading-shell .page-loading-retry:active{opacity:.82}
@keyframes table-dot{0%,80%,100%{opacity:.45;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}
@media(max-height:500px){.page-loading-shell{padding:20px}.page-loading-avatar{width:76px;height:76px;margin-bottom:14px}.page-loading-avatar image{width:60px;height:60px}.page-loading-error{margin-top:8px;margin-bottom:16px}}
@media(prefers-reduced-motion:reduce){.page-loading-dots>view{animation:none;opacity:.65}}
